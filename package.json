{
  "name": "bilheteria",
  "version": "1.4.0",
  "private": true,
  "description": "Bilheteria — bilheteira digital (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create bilheteria",
    "db:local": "wrangler d1 execute bilheteria --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute bilheteria --remote --file=./migrations/0001_init.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "qrcode-generator": "2.0.4"
  }
}
